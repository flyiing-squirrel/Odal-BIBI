APP_NAME=자격증 패스 코치 API
APP_ENV=local
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# 비워 두면 backend/odal.db(SQLite)를 사용 — Docker·Postgres 없이 바로 실행됨
# Postgres 예시: postgresql+psycopg://odal:비밀번호@localhost:5432/odal  (Neon의 postgres://... 주소도 그대로 넣으면 됨)
DATABASE_URL=""

# docker compose를 쓸 때만 필요. POSTGRES_PASSWORD는 반드시 직접 정한다
POSTGRES_USER=odal
POSTGRES_PASSWORD=""
POSTGRES_DB=odal

# Groq (https://console.groq.com) — 비어 있으면 MockLLMProvider 사용, 대화 API는 503
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# Tavily 검색 (https://tavily.com) — 비어 있으면 검색 없이 답변
TAVILY_API_KEY=""

# LLM 비용 보호: RATE_LIMIT_WINDOW_MINUTES 동안 세션당 메시지 수, IP당 세션 생성 수
RATE_LIMIT_WINDOW_MINUTES=10
MAX_MESSAGES_PER_WINDOW=20
MAX_SESSIONS_PER_WINDOW=10
