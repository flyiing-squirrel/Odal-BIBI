APP_NAME=자격증 패스 코치 API
APP_ENV=local
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
BACKEND_API_URL=http://localhost:8000
# Use the same random secret (at least 32 bytes) in the Next.js and FastAPI server environments.
BFF_SHARED_SECRET=""
SESSION_CREATION_LIMIT_PER_HOUR=5
PROFILE_UPDATES_PER_HOUR=5
CHAT_MESSAGES_PER_HOUR=30
RATE_LIMIT_WINDOW_SECONDS=3600

# PostgreSQL (docker compose의 db 서비스와 일치)
POSTGRES_USER=odal
POSTGRES_PASSWORD=odal
POSTGRES_DB=odal
# 로컬에서 uvicorn 실행 시 사용. docker compose의 api 컨테이너는 db 호스트로 자동 설정됨
DATABASE_URL=postgresql+psycopg://odal:odal@localhost:5432/odal
DB_POOL_SIZE=1
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=5
DB_POOL_PRE_PING=true

# Groq (https://console.groq.com) — 비어 있으면 MockLLMProvider 사용, 대화 API는 503
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# Tavily 검색 (https://tavily.com) — 비어 있으면 검색 없이 답변
TAVILY_API_KEY=""

# Google Calendar OAuth. Register this exact URI in Google Cloud OAuth credentials.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# Generate a 32-byte key and Base64 URL-safe encode it. Keep old versions during key rotation.
GOOGLE_TOKEN_ENCRYPTION_CURRENT_VERSION=v1
GOOGLE_TOKEN_ENCRYPTION_KEY_V1=""
GOOGLE_TOKEN_ENCRYPTION_KEY_V2=""
